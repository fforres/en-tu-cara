{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "En Tu Cara",
  "version": "0.2.0",
  "identifier": "dev.fforres.entucara",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "background",
        "url": "index.html?window=background",
        "title": "En Tu Cara",
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fforres/en-tu-cara/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMDc4MTI1OTU1NEUwOEMKUldTTTRGU1ZKWUVIU3M1R0N3cFhzTFNiQ05xak1LL015bjNMbW5pSUdBK2daUjAxOVkyczQrclYK"
    }
  }
}
